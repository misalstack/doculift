# Environment Variables for Invoice Parser

# Application
APP_ENV=development
DEBUG=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Model Configuration
USE_GPU=false
OCR_ENGINE=paddleocr

# Hugging Face (for downloading models)
HUGGINGFACE_TOKEN=your_token_here

# Logging
LOG_LEVEL=INFO
